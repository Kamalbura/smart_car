# TLS termination for the remote interface.
#
# The app talks HTTPS to Caddy; Caddy talks plain HTTP to remote-interface over
# the internal Docker network, which is never published to the host. So the
# Python service keeps its simple HTTP server and gains TLS without touching a
# line of its code.
#
# On the cipher choice: Go's crypto/tls detects at runtime whether the CPU has
# AES hardware, and prefers ChaCha20-Poly1305 when it does not. The Pi 4's
# Cortex-A72 has no ARMv8 crypto extensions, so this negotiates
# TLS_CHACHA20_POLY1305_SHA256 automatically — the fastest option on this
# hardware, chosen without configuration. Go does not permit TLS 1.3 cipher
# suites to be set manually, and here that is a feature: the automatic choice
# is already the right one.

{
	# No public domain and no reachable port 80, so ACME cannot work and would
	# only produce noisy retries. The certificate is supplied explicitly.
	auto_https off
	admin off
}

:8443 {
	tls /etc/caddy/certs/robot.crt /etc/caddy/certs/robot.key

	# Minimum TLS 1.2. TLS 1.3 is negotiated with any current client; this only
	# sets the floor for anything older.
	tls {
		protocols tls1.2 tls1.3
	}

	reverse_proxy remote-interface:8770 {
		# Disable response buffering. Without this the MJPEG stream is held in
		# Caddy's buffer and the app shows a frozen frame, or nothing at all —
		# the response never ends, so there is no flush point.
		flush_interval -1

		# Preserve the real client address. remote_interface still applies its
		# CIDR allowlist, and behind a proxy every request would otherwise
		# appear to come from Caddy.
		header_up X-Forwarded-For {remote_host}
		header_up X-Real-IP {remote_host}
	}

	log {
		output stderr
		format console
	}
}
