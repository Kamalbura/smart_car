# Copy this file to .env in the project root and fill in your values.
#
# Every value here MUST stay empty in version control. Only ever fill them in
# in your own untracked .env -- this template previously shipped a real
# Picovoice key by accident, and once a credential is committed the only fix
# is to rotate it.

# Path to a file containing Picovoice access key (optional)
# ACCESS_KEY_FILE=$HOME/.config/pi-assistant/pv_access_key

# Alternatively you can paste the access key directly (not recommended).
# Get one free at https://console.picovoice.ai
ACCESS_KEY=
PV_ACCESS_KEY=

# URL where .ppn keyword files can be downloaded (optional)
# PICO_URL=https://raw.githubusercontent.com/Picovoice/porcupine/master/resources/keyword_files/raspberry-pi

# Override project root if you need to run the script from elsewhere
# PROJECT_ROOT=/home/dev/project_root

# Shared secret for the remote HTTP interface. Strongly recommended, and
# REQUIRED when that service runs in a container: a Docker published port NATs
# every request, so the source-IP allowlist sees only the bridge gateway and
# can no longer tell a tailnet peer from anyone who reaches the port -- on an
# endpoint that commands the motors.
#   Generate with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
REMOTE_AUTH_TOKEN=

# Azure OpenAI (Responses API) configuration
# Use your Azure OpenAI resource endpoint (e.g., https://<resource>.openai.azure.com)
AZURE_OPENAI_ENDPOINT=
# API key for the Azure OpenAI resource
AZURE_OPENAI_API_KEY=
# Deployment name (e.g., gpt-5-mini) configured in Azure OpenAI Studio
AZURE_OPENAI_DEPLOYMENT=
# Optional API version (default in code: 2024-12-01-preview)
AZURE_OPENAI_API_VERSION=
